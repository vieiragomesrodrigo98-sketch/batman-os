# Batman OS — variáveis de ambiente do LLM Gateway (Vol.II Cap.8, Vol.IX
# Reference Implementation). Copie para `.env` e preencha os valores reais
# — `.env` nunca é commitado (ver .gitignore).
#
# Nenhuma destas variáveis é necessária para rodar `pytest`/`batman scan`:
# o LLM Gateway só é consultado quando o Kernel roda uma Mission real e nem
# regra nem humano resolvem um DecisionPoint a tempo (hierarquia Knowledge
# First -> Human Last -> LLM Last). Sem ANTHROPIC_API_KEY, uma tentativa de
# uso real levanta erro de autenticação da própria Anthropic — comportamento
# esperado, não um bug do batman-os.

# Chave da API Anthropic — nunca inline em código/config, só aqui.
ANTHROPIC_API_KEY=

# Modelo usado pelo LLM Gateway.
LLM_MODEL=claude-haiku-4-5-20251001

# Limite de tokens de saída por chamada.
LLM_MAX_TOKENS=1024

# Timeout (segundos) por chamada à API Anthropic.
LLM_TIMEOUT=30.0

# Teto diário de custo de LLM (USD) — circuit breaker fail-closed
# (batman_os.llm.cost_tracker): se o ledger de custo existir mas não puder
# ser lido, o Gateway BLOQUEIA novas chamadas em vez de liberar gasto sem
# conseguir contabilizar.
MAX_DAILY_LLM_COST_USD=10.0
